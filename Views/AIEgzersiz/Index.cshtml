@model EgzersizOnerisiViewModel
@{
    ViewData["Title"] = "AI Egzersiz Önerileri";
}

<h2>@ViewData["Title"]</h2>
<p class="lead">Yapay zeka ile size özel egzersiz programı önerileri alın.</p>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="GetRecommendation" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="VucutTipi" class="form-label"></label>
                <select asp-for="VucutTipi" class="form-select">
                    <option value="">-- Seçiniz --</option>
                    <option value="Ektomorf">Ektomorf (İnce yapılı)</option>
                    <option value="Mezomorf">Mezomorf (Atletik yapılı)</option>
                    <option value="Endomorf">Endomorf (Yuvarlak yapılı)</option>
                </select>
                <span asp-validation-for="VucutTipi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Boy" class="form-label"></label>
                <input asp-for="Boy" class="form-control" type="number" step="0.1" placeholder="Örn: 175" />
                <span asp-validation-for="Boy" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Kilo" class="form-label"></label>
                <input asp-for="Kilo" class="form-control" type="number" step="0.1" placeholder="Örn: 70" />
                <span asp-validation-for="Kilo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Hedef" class="form-label"></label>
                <textarea asp-for="Hedef" class="form-control" rows="3"
                    placeholder="Örn: Kilo vermek, kas geliştirmek, genel sağlık"></textarea>
                <span asp-validation-for="Hedef" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Foto" class="form-label">Fotoğraf (Opsiyonel)</label>
                <input asp-for="Foto" type="file" class="form-control" accept="image/*" />
                <small class="form-text text-muted">Vücut fotoğrafınızı yükleyebilirsiniz (JPG, PNG)</small>
                <span asp-validation-for="Foto" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="GorselSonucIste" class="form-check-input" type="checkbox" />
                <label asp-for="GorselSonucIste" class="form-check-label">
                    Egzersiz sonrası nasıl görüneceğimi göster
                </label>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-robot me-2"></i>AI Önerisi Al
                </button>
            </div>
        </form>
    </div>

    <div class="col-md-6">
        @if (ViewBag.Recommendation != null)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-robot me-2"></i>AI Önerisi
                    </h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.FotoYolu != null)
                    {
                        <div class="mb-3 text-center">
                            <img src="@ViewBag.FotoYolu" alt="Yüklenen Fotoğraf" class="img-fluid rounded"
                                style="max-height: 300px;" />
                            <p class="text-muted mt-2"><small>Yüklenen fotoğraf</small></p>
                        </div>
                    }
                    <div class="whitespace-pre-line">@ViewBag.Recommendation</div>
                    @if (ViewBag.GorselSonucIste == true)
                    {
                        <div class="alert alert-info mt-3">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Görsel Sonuç:</strong> AI, egzersiz programını takip ettikten sonra nasıl görüneceğinizi
                            yukarıdaki öneride açıklamıştır.
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <h5><i class="bi bi-info-circle me-2"></i>Nasıl Çalışır?</h5>
                <p>Yapay zeka, girdiğiniz bilgilere göre size özel bir egzersiz programı önerir:</p>
                <ul>
                    <li>Vücut tipi, boy, kilo ve hedeflerinize göre kişiselleştirilmiş öneriler</li>
                    <li>İsterseniz fotoğraf yükleyerek daha detaylı analiz</li>
                    <li>Egzersiz sonrası nasıl görüneceğinizi öğrenme seçeneği</li>
                </ul>
            </div>
        }
    </div>
</div>

<style>
    .whitespace-pre-line {
        white-space: pre-line;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
