@{
    ViewData["Title"] = "Hata";
}

<div class="text-center">
    <h1 class="display-4 text-danger">Hata Oluştu</h1>
    <p class="lead">Üzgünüz, bir hata oluştu. Lütfen daha sonra tekrar deneyin.</p>
    
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger mt-4 text-start">
            <h5>Hata Detayı:</h5>
            <p><strong>@ViewBag.ErrorMessage</strong></p>
            @if (ViewBag.StackTrace != null)
            {
                <details class="mt-3">
                    <summary>Stack Trace (Geliştiriciler için)</summary>
                    <pre class="mt-2 small">@ViewBag.StackTrace</pre>
                </details>
            }
            @if (ViewBag.RequestId != null)
            {
                <p class="mt-2 small text-muted">Request ID: @ViewBag.RequestId</p>
            }
        </div>
    }
    
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Ana Sayfaya Dön</a>
</div>

