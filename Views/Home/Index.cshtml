@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center">
    <h1 class="display-4">Spor Salonu Yönetim ve Randevu Sistemi</h1>
    <p class="lead">Spor salonu hizmetlerini yönetin, antrenörlerle randevu alın ve kişiselleştirilmiş egzersiz önerileri alın.</p>
    
    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Randevu Al</h5>
                    <p class="card-text">Uygun antrenör ve saat seçerek randevu alabilirsiniz.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Antrenörler</h5>
                    <p class="card-text">Uzman antrenörlerimiz ve hizmetlerimizi keşfedin.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">AI Önerileri</h5>
                    <p class="card-text">Yapay zeka ile size özel egzersiz önerileri alın.</p>
                </div>
            </div>
        </div>
    </div>
</div>



