@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center mb-5 py-4">
    <h1 class="display-4 fw-bold mb-3">Spor Salonu Yönetim ve Randevu Sistemi</h1>
    <p class="lead">Spor salonu hizmetlerini yönetin, antrenörlerle randevu alın ve kişiselleştirilmiş egzersiz
        önerileri alın.</p>
</div>

<!-- İstatistikler -->
<div class="row mb-5">
    <div class="col-md-3 mb-4">
        <div class="card text-center border-primary h-100">
            <div class="card-body">
                <div class="mb-3">
                    <i class="bi bi-person-badge text-primary" style="font-size: 3rem;"></i>
                </div>
                <h2 class="mb-2"
                    style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                    @ViewBag.ToplamAntrenor</h2>
                <p class="card-text fw-semibold">Antrenör</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-center border-success h-100">
            <div class="card-body">
                <div class="mb-3">
                    <i class="bi bi-star-fill text-success" style="font-size: 3rem;"></i>
                </div>
                <h2 class="mb-2"
                    style="background: var(--success-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                    @ViewBag.ToplamHizmet</h2>
                <p class="card-text fw-semibold">Hizmet</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-center border-info h-100">
            <div class="card-body">
                <div class="mb-3">
                    <i class="bi bi-calendar-check-fill text-info" style="font-size: 3rem;"></i>
                </div>
                <h2 class="mb-2"
                    style="background: var(--success-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                    @ViewBag.ToplamRandevu</h2>
                <p class="card-text fw-semibold">Randevu</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-center border-warning h-100">
            <div class="card-body">
                <div class="mb-3">
                    <i class="bi bi-building text-warning" style="font-size: 3rem;"></i>
                </div>
                <h2 class="mb-2"
                    style="background: var(--warning-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                    @(ViewBag.SporSalonlari != null ? ((List<SporSalonu>)ViewBag.SporSalonlari).Count : 0)</h2>
                <p class="card-text fw-semibold">Spor Salonu</p>
            </div>
        </div>
    </div>
</div>

<!-- Özellikler -->
<div class="row mb-5">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-calendar-check-fill text-primary" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title fw-bold">Randevu Al</h5>
                <p class="card-text">Uygun antrenör ve saat seçerek randevu alabilirsiniz. Müsaitlik kontrolü otomatik
                    yapılır.</p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Randevu" asp-action="Create" class="btn btn-primary mt-2">
                        <i class="bi bi-calendar-plus me-2"></i>Randevu Al
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-2">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                    </a>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-people-fill text-success" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title fw-bold">Antrenörler</h5>
                <p class="card-text">Uzman antrenörlerimiz ve hizmetlerimizi keşfedin. Her antrenörün uzmanlık alanları
                    ve müsaitlik saatleri görüntülenebilir.</p>
                <a asp-controller="Antrenor" asp-action="PublicList" class="btn btn-success mt-2">
                    <i class="bi bi-arrow-right-circle me-2"></i>Antrenörleri Gör
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-robot text-warning" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title fw-bold">AI Önerileri</h5>
                <p class="card-text">Yapay zeka ile size özel egzersiz önerileri alın. Vücut tipinize ve hedeflerinize
                    göre kişiselleştirilmiş programlar.</p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="AIEgzersiz" asp-action="Index" class="btn btn-warning mt-2">
                        <i class="bi bi-magic me-2"></i>AI Önerileri
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-warning mt-2">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Spor Salonları -->
@if (ViewBag.SporSalonlari != null && ((List<SporSalonu>)ViewBag.SporSalonlari).Any())
{
    <div class="mb-5">
        <h3 class="mb-4 fw-bold">
            <i class="bi bi-building me-2"></i>Spor Salonlarımız
        </h3>
        <div class="row">
            @foreach (var salon in (List<SporSalonu>)ViewBag.SporSalonlari)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-3">
                                <i class="bi bi-building-fill me-2 text-primary"></i>@salon.Ad
                            </h5>
                            <p class="card-text mb-2">
                                <i class="bi bi-clock-fill me-2 text-primary"></i>
                                <strong>Çalışma Saatleri:</strong> @salon.AcilisSaati.ToString(@"hh\:mm") -
                                @salon.KapanisSaati.ToString(@"hh\:mm")
                            </p>
                            @if (salon.Adres != null)
                            {
                                <p class="card-text mb-2">
                                    <i class="bi bi-geo-alt-fill me-2 text-primary"></i>
                                    <strong>Adres:</strong> @salon.Adres
                                </p>
                            }
                            <p class="card-text">
                                <span class="badge bg-primary me-2">
                                    <i class="bi bi-person-badge me-1"></i>@(salon.Antrenorler?.Count ?? 0) Antrenör
                                </span>
                                <span class="badge bg-success">
                                    <i class="bi bi-star me-1"></i>@(salon.Hizmetler?.Count ?? 0) Hizmet
                                </span>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
