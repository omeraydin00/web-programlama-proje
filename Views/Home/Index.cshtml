@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center mb-5">
    <h1 class="display-4 fw-bold text-primary">Spor Salonu Yönetim ve Randevu Sistemi</h1>
    <p class="lead">Spor salonu hizmetlerini yönetin, antrenörlerle randevu alın ve kişiselleştirilmiş egzersiz önerileri alın.</p>
</div>

<!-- İstatistikler -->
<div class="row mb-5">
    <div class="col-md-3">
        <div class="card text-center border-primary">
            <div class="card-body">
                <h2 class="text-primary">@ViewBag.ToplamAntrenor</h2>
                <p class="card-text">Antrenör</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-success">
            <div class="card-body">
                <h2 class="text-success">@ViewBag.ToplamHizmet</h2>
                <p class="card-text">Hizmet</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-info">
            <div class="card-body">
                <h2 class="text-info">@ViewBag.ToplamRandevu</h2>
                <p class="card-text">Randevu</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-warning">
            <div class="card-body">
                <h2 class="text-warning">@(ViewBag.SporSalonlari != null ? ((List<SporSalonu>)ViewBag.SporSalonlari).Count : 0)</h2>
                <p class="card-text">Spor Salonu</p>
            </div>
        </div>
    </div>
</div>

<!-- Özellikler -->
<div class="row mb-5">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-calendar-check" style="font-size: 3rem; color: #0d6efd;"></i>
                </div>
                <h5 class="card-title">Randevu Al</h5>
                <p class="card-text">Uygun antrenör ve saat seçerek randevu alabilirsiniz. Müsaitlik kontrolü otomatik yapılır.</p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Randevu" asp-action="Create" class="btn btn-primary">Randevu Al</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Giriş Yap</a>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-people" style="font-size: 3rem; color: #198754;"></i>
                </div>
                <h5 class="card-title">Antrenörler</h5>
                <p class="card-text">Uzman antrenörlerimiz ve hizmetlerimizi keşfedin. Her antrenörün uzmanlık alanları ve müsaitlik saatleri görüntülenebilir.</p>
                <a asp-controller="Antrenor" asp-action="PublicList" class="btn btn-success">Antrenörleri Gör</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-robot" style="font-size: 3rem; color: #ffc107;"></i>
                </div>
                <h5 class="card-title">AI Önerileri</h5>
                <p class="card-text">Yapay zeka ile size özel egzersiz önerileri alın. Vücut tipinize ve hedeflerinize göre kişiselleştirilmiş programlar.</p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="AIEgzersiz" asp-action="Index" class="btn btn-warning">AI Önerileri</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-warning">Giriş Yap</a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Spor Salonları -->
@if (ViewBag.SporSalonlari != null && ((List<SporSalonu>)ViewBag.SporSalonlari).Any())
{
    <h3 class="mb-4">Spor Salonlarımız</h3>
    <div class="row">
        @foreach (var salon in (List<SporSalonu>)ViewBag.SporSalonlari)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@salon.Ad</h5>
                        <p class="card-text">
                            <small class="text-muted">
                                <i class="bi bi-clock"></i> @salon.AcilisSaati.ToString(@"hh\:mm") - @salon.KapanisSaati.ToString(@"hh\:mm")
                            </small>
                        </p>
                        @if (salon.Adres != null)
                        {
                            <p class="card-text"><small><i class="bi bi-geo-alt"></i> @salon.Adres</small></p>
                        }
                        <p class="card-text">
                            <small class="text-muted">
                                @(salon.Antrenorler?.Count ?? 0) Antrenör • @(salon.Hizmetler?.Count ?? 0) Hizmet
                            </small>
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}







