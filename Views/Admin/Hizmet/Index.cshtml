@model IEnumerable<Hizmet>
@{
    ViewData["Title"] = "Hizmetler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-star me-2"></i>@ViewData["Title"]
        </h2>
        <p class="text-muted mb-0">Hizmetleri yönetin</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Yeni Hizmet Ekle
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info d-flex align-items-center">
        <i class="bi bi-info-circle-fill me-3" style="font-size: 2rem;"></i>
        <div>
            <h5 class="alert-heading mb-1">Henüz hizmet eklenmemiş</h5>
            <p class="mb-0">İlk hizmeti eklemek için yukarıdaki butona tıklayın.</p>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th><i class="bi bi-tag me-2"></i>Ad</th>
                    <th><i class="bi bi-grid me-2"></i>Hizmet Türü</th>
                    <th><i class="bi bi-clock me-2"></i>Süre</th>
                    <th><i class="bi bi-currency-dollar me-2"></i>Ücret</th>
                    <th><i class="bi bi-building me-2"></i>Spor Salonu</th>
                    <th class="text-end"><i class="bi bi-gear me-2"></i>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Ad</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.HizmetTuru))
                            {
                                <span class="badge bg-info">@item.HizmetTuru</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-secondary">
                                <i class="bi bi-hourglass-split me-1"></i>@item.Sure dk
                            </span>
                        </td>
                        <td class="fw-semibold text-success">@item.Ucret.ToString("C")</td>
                        <td>
                            @if (item.SporSalonu != null)
                            {
                                <span class="badge bg-primary">@item.SporSalonu.Ad</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Detay">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
