@model Hizmet
@{
    ViewData["Title"] = "Hizmet Düzenle";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="OlusturmaTarihi" />
            
            <div class="mb-3">
                <label asp-for="Ad" class="form-label"></label>
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HizmetTuru" class="form-label">Hizmet Türü</label>
                <input asp-for="HizmetTuru" class="form-control" placeholder="Örn: Fitness, Yoga, Pilates" />
                <span asp-validation-for="HizmetTuru" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Aciklama" class="form-label"></label>
                <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Aciklama" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Sure" class="form-label">Süre (Dakika)</label>
                    <input asp-for="Sure" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Sure" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Ucret" class="form-label">Ücret (₺)</label>
                    <input asp-for="Ucret" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Ucret" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="SporSalonuId" class="form-label">Spor Salonu</label>
                <select asp-for="SporSalonuId" class="form-select" asp-items="ViewBag.SporSalonuId">
                    <option value="">-- Spor Salonu Seçin --</option>
                </select>
                <span asp-validation-for="SporSalonuId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}





