@model Hizmet
@{
    ViewData["Title"] = "Hizmet Detayları";
}

<h2>@ViewData["Title"]</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Ad:</dt>
    <dd class="col-sm-9">@Model.Ad</dd>

    <dt class="col-sm-3">Hizmet Türü:</dt>
    <dd class="col-sm-9">@(Model.HizmetTuru ?? "-")</dd>

    <dt class="col-sm-3">Açıklama:</dt>
    <dd class="col-sm-9">@(Model.Aciklama ?? "-")</dd>

    <dt class="col-sm-3">Süre:</dt>
    <dd class="col-sm-9">@Model.Sure dakika</dd>

    <dt class="col-sm-3">Ücret:</dt>
    <dd class="col-sm-9">@Model.Ucret.ToString("C")</dd>

    <dt class="col-sm-3">Spor Salonu:</dt>
    <dd class="col-sm-9">@(Model.SporSalonu?.Ad ?? "-")</dd>

    <dt class="col-sm-3">Oluşturma Tarihi:</dt>
    <dd class="col-sm-9">@Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>
    <a asp-action="Index" class="btn btn-secondary">Geri Dön</a>
</div>


