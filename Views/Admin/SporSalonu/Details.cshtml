@model SporSalonu
@{
    ViewData["Title"] = "Spor Salonu Detayları";
}

<h2>@ViewData["Title"]</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Ad:</dt>
    <dd class="col-sm-9">@Model.Ad</dd>

    <dt class="col-sm-3">Adres:</dt>
    <dd class="col-sm-9">@(Model.Adres ?? "-")</dd>

    <dt class="col-sm-3">Telefon:</dt>
    <dd class="col-sm-9">@(Model.Telefon ?? "-")</dd>

    <dt class="col-sm-3">Email:</dt>
    <dd class="col-sm-9">@(Model.Email ?? "-")</dd>

    <dt class="col-sm-3">Çalışma Saatleri:</dt>
    <dd class="col-sm-9">@Model.AcilisSaati.ToString(@"hh\:mm") - @Model.KapanisSaati.ToString(@"hh\:mm")</dd>

    <dt class="col-sm-3">Oluşturma Tarihi:</dt>
    <dd class="col-sm-9">@Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</dd>
</dl>

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h4 class="mb-0">Hizmetler</h4>
    <a asp-controller="Hizmet" asp-action="Create" asp-route-sporSalonuId="@Model.Id" class="btn btn-sm btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Yeni Hizmet Ekle
    </a>
</div>
@if (Model.Hizmetler != null && Model.Hizmetler.Any())
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Ad</th>
                    <th>Tür</th>
                    <th>Süre (dk)</th>
                    <th>Ücret</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hizmet in Model.Hizmetler)
                {
                    <tr>
                        <td class="fw-semibold">@hizmet.Ad</td>
                        <td>@(hizmet.HizmetTuru ?? "-")</td>
                        <td>@hizmet.Sure</td>
                        <td>@hizmet.Ucret.ToString("C")</td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <a asp-controller="Hizmet" asp-action="Details" asp-route-id="@hizmet.Id" class="btn btn-sm btn-info" title="Detay">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="Hizmet" asp-action="Edit" asp-route-id="@hizmet.Id" class="btn btn-sm btn-warning" title="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-controller="Hizmet" asp-action="Delete" asp-route-id="@hizmet.Id" class="btn btn-sm btn-danger" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>Henüz hizmet eklenmemiş.
    </div>
}

<h4 class="mt-4">Antrenörler</h4>
@if (Model.Antrenorler != null && Model.Antrenorler.Any())
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Ad Soyad</th>
                <th>Email</th>
                <th>Telefon</th>
                <th>Uzmanlık Alanları</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var antrenor in Model.Antrenorler)
            {
                <tr>
                    <td>@antrenor.Ad @antrenor.Soyad</td>
                    <td>@(antrenor.Email ?? "-")</td>
                    <td>@(antrenor.Telefon ?? "-")</td>
                    <td>@(antrenor.UzmanlikAlanlari ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Henüz antrenör eklenmemiş.</p>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>
    <a asp-action="Index" class="btn btn-secondary">Geri Dön</a>
</div>







