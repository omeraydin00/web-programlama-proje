@model IEnumerable<SporSalonu>
@{
    ViewData["Title"] = "Spor Salonları";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-building me-2"></i>@ViewData["Title"]
        </h2>
        <p class="text-muted mb-0">Spor salonlarını yönetin</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Yeni Spor Salonu Ekle
    </a>
</div>

