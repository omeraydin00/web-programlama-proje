@model IEnumerable<Randevu>
@{
    ViewData["Title"] = "Randevu Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-calendar-check me-2"></i>@ViewData["Title"]
        </h2>
        <p class="text-muted mb-0">Tüm randevuları görüntüleyin ve yönetin</p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="durum" class="form-label">Durum Filtresi</label>
                <select name="durum" id="durum" class="form-select">
                    <option value="">Tüm Durumlar</option>
                    <option value="Beklemede" selected="@(ViewBag.Durum == "Beklemede")">Beklemede</option>
                    <option value="Onaylandı" selected="@(ViewBag.Durum == "Onaylandı")">Onaylandı</option>
                    <option value="İptal" selected="@(ViewBag.Durum == "İptal")">İptal</option>
                    <option value="Tamamlandı" selected="@(ViewBag.Durum == "Tamamlandı")">Tamamlandı</option>
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-2"></i>Filtrele
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-2"></i>Temizle
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info d-flex align-items-center">
        <i class="bi bi-info-circle-fill me-3" style="font-size: 2rem;"></i>
        <div>
            <h5 class="alert-heading mb-1">Henüz randevu bulunmamaktadır</h5>
            <p class="mb-0">Sistemde kayıtlı randevu bulunmamaktadır.</p>
        </div>
    </div>
}
