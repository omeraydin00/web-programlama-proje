@model IEnumerable<Randevu>
@{
    ViewData["Title"] = "Randevu Yönetimi";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div class="mb-3">
    <form method="get" class="d-inline-flex gap-2">
        <select name="durum" class="form-select" style="width: auto;">
            <option value="">Tüm Durumlar</option>
            <option value="Beklemede" selected="@(ViewBag.Durum == "Beklemede")">Beklemede</option>
            <option value="Onaylandı" selected="@(ViewBag.Durum == "Onaylandı")">Onaylandı</option>
            <option value="İptal" selected="@(ViewBag.Durum == "İptal")">İptal</option>
            <option value="Tamamlandı" selected="@(ViewBag.Durum == "Tamamlandı")">Tamamlandı</option>
        </select>
        <button type="submit" class="btn btn-primary">Filtrele</button>
        <a asp-action="Index" class="btn btn-secondary">Temizle</a>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>Saat</th>
                <th>Üye</th>
                <th>Antrenör</th>
                <th>Hizmet</th>
                <th>Ücret</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.RandevuTarihi.ToString("dd.MM.yyyy")</td>
                    <td>@item.BaslangicSaati.ToString(@"hh\:mm") - @item.BitisSaati.ToString(@"hh\:mm")</td>
                    <td>@(item.Uye?.Ad ?? "-") @(item.Uye?.Soyad ?? "")</td>
                    <td>@(item.Antrenor?.Ad ?? "-") @(item.Antrenor?.Soyad ?? "")</td>
                    <td>@(item.Hizmet?.Ad ?? "-")</td>
                    <td>@item.ToplamUcret.ToString("C")</td>
                    <td>
                        @if (item.Durum == "Onaylandı")
                        {
                            <span class="badge bg-success">@item.Durum</span>
                        }
                        else if (item.Durum == "Beklemede")
                        {
                            <span class="badge bg-warning">@item.Durum</span>
                        }
                        else if (item.Durum == "İptal")
                        {
                            <span class="badge bg-danger">@item.Durum</span>
                        }
                        else
                        {
                            <span class="badge bg-info">@item.Durum</span>
                        }
                    </td>
                    <td>
                        @if (item.Durum == "Beklemede")
                        {
                            <form asp-action="Onayla" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">Onayla</button>
                            </form>
                            <form asp-action="Reddet" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger">Reddet</button>
                            </form>
                        }
                        else if (item.Durum == "Onaylandı")
                        {
                            <form asp-action="Tamamla" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-primary">Tamamla</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>




