@model ApplicationUser
@{
    ViewData["Title"] = "Hesap Bilgileri";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h2>@ViewData["Title"]</h2>
        <hr />

        <dl class="row">
            <dt class="col-sm-3">Ad Soyad:</dt>
            <dd class="col-sm-9">@Model.Ad @Model.Soyad</dd>

            <dt class="col-sm-3">E-posta:</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Telefon:</dt>
            <dd class="col-sm-9">@(Model.Telefon ?? "-")</dd>

            <dt class="col-sm-3">Doğum Tarihi:</dt>
            <dd class="col-sm-9">@(Model.DogumTarihi?.ToString("dd.MM.yyyy") ?? "-")</dd>

            <dt class="col-sm-3">Adres:</dt>
            <dd class="col-sm-9">@(Model.Adres ?? "-")</dd>

            <dt class="col-sm-3">Roller:</dt>
            <dd class="col-sm-9">
                @if (ViewBag.UserRoles != null)
                {
                    @string.Join(", ", (IEnumerable<string>)ViewBag.UserRoles)
                }
            </dd>
        </dl>

        <div class="mt-3">
            <a asp-action="Edit" class="btn btn-primary">Bilgileri Düzenle</a>
        </div>
    </div>
</div>





